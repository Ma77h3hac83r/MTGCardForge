---
import SiteLayout from "@/layouts/SiteLayout.astro";
---

<SiteLayout
  title="Terms | MTG Card Forge"
  description="Terms information for MTG Card Forge."
>
  <section class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="rounded-lg border bg-card p-8 shadow-sm">
      <h1 class="text-3xl font-semibold tracking-normal">Terms</h1>
      <p class="mt-4 max-w-3xl text-sm leading-6 text-muted-foreground">
        MTG Card Forge is an unofficial Magic card lookup tool. Magic: The Gathering card data, names, and images
        belong to their respective owners and are provided through public third-party services.
      </p>
    </div>
  </section>
</SiteLayout>
