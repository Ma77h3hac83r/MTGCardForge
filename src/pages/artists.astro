---
import { ArtistSearch } from "@/components/ArtistSearch";
import SiteFooter from "@/components/SiteFooter.astro";
import faviconUrl from "@/images/favicon.ico";
const faviconHref = typeof faviconUrl === "string" ? faviconUrl : faviconUrl.src;
import "@/styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Search Magic artists and browse their paper card artwork." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={faviconHref} />
    <title>Artists | MTG Card Forge</title>
  </head>
  <body>
    <main>
      <ArtistSearch client:load />
    </main>
    <SiteFooter />
  </body>
</html>
