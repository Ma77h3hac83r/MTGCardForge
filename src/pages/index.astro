---
import HomeRandomPrintings from "@/components/HomeRandomPrintings";
import SiteLayout from "@/layouts/SiteLayout.astro";

const tools = [
  {
    href: "/printings",
    label: "Printings",
    symbol: "ms-u",
    stat: "Exact names",
  },
  {
    href: "/sets",
    label: "Sets",
    symbol: "ms-g",
    stat: "Full releases",
  },
  {
    href: "/tokens",
    label: "Tokens",
    symbol: "ms-r",
    stat: "Produced pieces",
  },
  {
    href: "/artists",
    label: "Artists",
    symbol: "ms-w",
    stat: "Galleries",
  },
  {
    href: "/deck",
    label: "Deck",
    symbol: "ms-b",
    stat: "Pasted lists",
  },
];
---

<SiteLayout
  title="MTG Card Forge"
  description="Search Magic cards, compare printings, explore sets, tokens, artists, and deck lists."
>
  <section class="mx-auto w-full max-w-7xl space-y-12 px-4 py-8 sm:px-6 lg:px-8">
    <section class="overflow-hidden rounded-lg border bg-card shadow-sm">
      <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_minmax(260px,360px)] lg:items-center">
        <div class="max-w-3xl space-y-6">
          <div class="flex flex-wrap items-center gap-2 text-2xl" aria-label="Magic mana colors">
            <span class="ms ms-cost ms-w shadow-sm" role="img" aria-label="White mana"></span>
            <span class="ms ms-cost ms-u shadow-sm" role="img" aria-label="Blue mana"></span>
            <span class="ms ms-cost ms-b shadow-sm" role="img" aria-label="Black mana"></span>
            <span class="ms ms-cost ms-r shadow-sm" role="img" aria-label="Red mana"></span>
            <span class="ms ms-cost ms-g shadow-sm" role="img" aria-label="Green mana"></span>
            <span class="ms ms-cost ms-c shadow-sm" role="img" aria-label="Colorless mana"></span>
          </div>

          <div>
            <h1 class="max-w-4xl text-4xl font-semibold tracking-normal sm:text-5xl">
              MTG Card Forge
            </h1>
            <p class="mt-4 max-w-2xl text-base leading-7 text-muted-foreground">
              A focused Magic research bench for comparing paper printings, browsing complete releases, tracing tokens, checking artists, and turning deck lists into useful card sections.
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <a
              class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
              href="/printings"
            >
              Search Printings
            </a>
            <a
              class="inline-flex h-10 items-center justify-center rounded-md border bg-background px-4 text-sm font-medium transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
              href="/deck"
            >
              Paste a Deck
            </a>
          </div>
        </div>

        <HomeRandomPrintings client:load />
      </div>
    </section>

    <section>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          tools.map((tool) => (
            <a
              class="group block overflow-hidden rounded-lg border bg-card shadow-sm transition-colors hover:border-primary/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
              href={tool.href}
            >
              <div class="flex min-h-32 flex-col justify-between p-5">
                <div>
                  <span class={`ms ms-cost ${tool.symbol} text-xl shadow-sm`} aria-hidden="true"></span>
                  <h3 class="mt-4 text-xl font-semibold tracking-normal">{tool.label}</h3>
                  <p class="mt-2 text-sm font-medium text-muted-foreground">{tool.stat}</p>
                </div>
                <span class="mt-5 text-2xl text-muted-foreground transition-transform group-hover:translate-x-1" aria-hidden="true">
                  &rarr;
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </section>
</SiteLayout>
