---
import SiteLayout from "@/layouts/SiteLayout.astro";
---

<SiteLayout
  title="Privacy | MTG Card Forge"
  description="Privacy information for MTG Card Forge."
>
  <section class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="rounded-lg border bg-card p-8 shadow-sm">
      <h1 class="text-3xl font-semibold tracking-normal">Privacy</h1>
      <p class="mt-4 max-w-3xl text-sm leading-6 text-muted-foreground">
        MTG Card Forge runs as a static browser app. Searches and deck imports are sent from your browser to the
        relevant public card data providers needed to load results.
      </p>
    </div>
  </section>
</SiteLayout>
