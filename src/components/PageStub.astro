---
const { title, description } = Astro.props;
---

<section class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="rounded-lg border bg-card p-8 shadow-sm">
    <p class="text-sm font-medium uppercase tracking-normal text-muted-foreground">MTG Card Forge</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-normal">{title}</h1>
    <p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground">{description}</p>
  </div>
</section>
